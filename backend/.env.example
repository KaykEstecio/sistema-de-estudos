# Copie para backend/.env. Nunca versione valores sensíveis.
APP_NAME=CodeTrack
ENVIRONMENT=development
# Deve permanecer false em production.
CODETRACK_DEBUG=false
# Obrigatória. Preencha a URL somente no .env local; nunca publique seu valor.
# Use o driver postgresql+psycopg e credenciais do PostgreSQL local.
DATABASE_URL=
# Obrigatória para JWT. Gere um segredo aleatório; nunca publique seu valor.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
