{
  "name": "codetrack-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "npm run typecheck:e2e && playwright test",
    "test:e2e:controlled": "npm run test:e2e -- --project=controlled-desktop --project=controlled-mobile",
    "test:e2e:real": "npm run test:e2e -- --project=real"
  },
  "dependencies": {
    "axios": "1.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
